# ==============================================================================
# Tetlatsontekiliani — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate the keys for the providers you want
# to evaluate. You do NOT need to configure every provider; unconfigured
# providers are automatically disabled in the UI and skipped during batch runs.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Concurrency Settings
# ------------------------------------------------------------------------------
# Port for the Next.js application server (default: 3200)
PORT=3200

# Maximum number of providers queried concurrently during batch benchmark runs
MAX_CONCURRENT_PROVIDERS=3

# ------------------------------------------------------------------------------
# Google Gemini (Direct API)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=
# Default model selection (can also be selected from the UI catalog)
GOOGLE_GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OpenAI (Direct API)
# ------------------------------------------------------------------------------
# Get your API key from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Default model selection (e.g. gpt-6.1-sol-pro, gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-6.1-sol-pro

# ------------------------------------------------------------------------------
# Anthropic Claude (Direct API)
# ------------------------------------------------------------------------------
# Get your API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model selection (e.g. claude-haiku-5.5, claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=claude-haiku-5.5

# ------------------------------------------------------------------------------
# LM Studio (Local Offline LLM)
# ------------------------------------------------------------------------------
# URL for local LM Studio OpenAI-compatible server. Ensure LM Studio server is
# started with CORS enabled (e.g. http://localhost:1234/v1/chat/completions).
LM_STUDIO_API_URL=http://localhost:1234/v1/chat/completions
# Model identifier loaded inside LM Studio (e.g. qwen3.6-27b)
LM_STUDIO_MODEL=qwen3.6-27b
# Request timeout in milliseconds (default: 120000 = 2 minutes) for local inference
LM_STUDIO_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# OpenRouter Aggregator
# ------------------------------------------------------------------------------
# Single API key to query multiple models or route requests through OpenRouter.
# Required for Nvidia Nemotron models. Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# Nvidia Models (Routed via OpenRouter)
# ------------------------------------------------------------------------------
# Model identifier for Nvidia Nemotron on OpenRouter (requires OPENROUTER_API_KEY)
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
